# Neon PostgreSQL connection string (the "Pooled connection" one, host with -pooler). Keep the real value private.
# Empty = local JSON files in data/. Against an empty Neon database the first start uploads those files once.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
GITHUB_ACTIONS_TOKEN=token_con_permiso_actions
REUNION_SYNC_TOKEN=token_privado_para_callback
GITHUB_REPOSITORY=0322203936-cmd/Reunion-123-WEB

# Credenciales locales para el bot Actualizar Data.
POSCO_USER=usuario@email.com
POSCO_PASSWORD=coloca_la_contraseña_local
# Opcional: por defecto usa Microsoft Edge instalado en Windows.
# Optional locally. Leave empty on Render so Playwright uses bundled Chromium.
# POSCO_BROWSER_CHANNEL=msedge
# POSCO_LOAD_WAIT_MS=120000
